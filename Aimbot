local function addESP(c)
    if not c or not esp or c:FindFirstChild("EGY_ESP") then return end
    local h = Instance.new("Highlight")
    h.Name, h.Adornee = "EGY_ESP", c
    h.FillColor, h.FillTransparency = Color3.fromRGB(0, 255, 0), 0.5
    h.OutlineColor, h.OutlineTransparency = Color3.fromRGB(0, 255, 0), 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = c
end

tab:CreateToggle({
    Name = "كشف اماكن ESP",
    CurrentValue = false,
    Flag = "ESPToggle",
    Callback = function(v)
        esp = v
        for _, p in pairs(plrs:GetPlayers()) do
            if p ~= lp and p.Character then
                if v then addESP(p.Character) else
                    local e = p.Character:FindFirstChild("EGY_ESP")
                    if e then e:Destroy() end
                end
            end
        end
    end
})

rs.RenderStepped:Connect(function()
    crc.Radius, crc.Color = fov, col
    
    if aim and lp.Character then
        crc.Visible = true
        crc.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        
        if not targ then
            local nt = getTarg()
            if nt and (os.clock() - aimTime >= lockDelay) then 
                targ = nt 
                aimTime = os.clock()
            elseif not nt then 
                aimTime = os.clock() 
            end
        end

        if targ then
            local h = targ.Parent and targ.Parent:FindFirstChild("Humanoid")
            
            if not h or h.Health <= 0 or not targ.Parent then
                targ = nil
                aimTime = os.clock()
            else
                local targetCFrame = CFrame.lookAt(cam.CFrame.Position, targ.Position)
                cam.CFrame = cam.CFrame:Lerp(targetCFrame, 0.4)
            end
        end
    else
        crc.Visible = false
        targ = nil
    end

    if esp then
        for _, p in pairs(plrs:GetPlayers()) do
            if p ~= lp and p.Character then addESP(p.Character) end
        end
    end
end)

lp.CharacterAdded:Connect(function()
    aim, targ, ignored = false, nil, {}
end)
