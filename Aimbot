local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local rs = game:GetService("RunService")
local uis = game:GetService("UserInputService")
local plrs = game:GetService("Players")
local lp = plrs.LocalPlayer
local cam = workspace.CurrentCamera

local win = Rayfield:CreateWindow({
    Name = "EGY DEV | BY EGY",
    LoadingTitle = "EGY DEV | BY EGY",
    LoadingSubtitle = "Loading...",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false
})

local aim, esp = false, false
local targ, fov, col = nil, 130, Color3.fromRGB(0, 255, 0)
local aimPart = "Head"
local ignored = {}
local flickCount, lastFlick = 0, 0
local lockDelay, aimTime = 0.05, 0

local crc = Drawing.new("Circle")
crc.Visible, crc.Thickness, crc.Transparency, crc.Filled = false, 1.5, 0.8, false

local function getPart(c)
    if aimPart == "Head" then return c:FindFirstChild("Head") end
    if aimPart == "Body" then return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") end
    if aimPart == "Legs" then return c:FindFirstChild("LeftUpperLeg") or c:FindFirstChild("LeftLeg") end
    return c:FindFirstChild("Head")
end

local function isVis(part, myChar)
    local param = RaycastParams.new()
    param.FilterDescendantsInstances = {myChar, part.Parent}
    param.FilterType = Enum.RaycastFilterType.Exclude
    local ray = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, param)
    return ray == nil
end

local function getTarg()
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local best, dist = nil, fov
    local t = tick()

    for _, v in pairs(plrs:GetPlayers()) do
        if v ~= lp and v.Character and not (ignored[v.Name] and ignored[v.Name] > t) then
            local c = v.Character
            local h = c:FindFirstChild("Humanoid")
            local p = getPart(c)
            
            if p and h and h.Health > 0 then
                local pos, onScreen = cam:WorldToViewportPoint(p.Position)
                if onScreen then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d <= dist and isVis(p, lp.Character) then
                        best, dist = p, d
                    end
                end
            end
        end
    end
    return best
end

uis.InputChanged:Connect(function(input, gp)
    if gp or not aim or not targ then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if input.Delta.Magnitude > 25 then
            local t = tick()
            if (t - lastFlick < 0.4) then 
                flickCount = flickCount + 1 
            else 
                flickCount = 1 
            end
            lastFlick = t
            
            if flickCount >= 2 then
                ignored[targ.Parent.Name] = t + 1
                targ = nil
                flickCount = 0
            end
        end
    end
end)

